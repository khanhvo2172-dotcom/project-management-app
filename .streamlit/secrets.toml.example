# Copy this file to `.streamlit/secrets.toml` for local dev, or paste the same
# content into Streamlit Community Cloud -> App -> Settings -> Secrets.
# Do NOT commit the real secrets.toml (it is git-ignored).
#
# Two ways to authenticate. Use ONE of the blocks below.

[sheet]
# Either the full URL or the spreadsheet key. Worksheet is the tab name.
url = "https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit"
worksheet = "Tasks"

# ---------------------------------------------------------------------------
# OPTION A (used here): OAuth user credentials. The app reads sheets AS your
# Google account, so no sharing step is needed. `scopes` MUST match the scopes
# the refresh token was granted, or refresh fails with invalid_scope.
# ---------------------------------------------------------------------------
[google_oauth]
token = "ya29..."                 # optional; refreshed automatically
refresh_token = "1//0..."
token_uri = "https://oauth2.googleapis.com/token"
client_id = "xxxxxxxx.apps.googleusercontent.com"
client_secret = "GOCSPX-..."
scopes = [
  "https://www.googleapis.com/auth/documents.readonly",
  "https://www.googleapis.com/auth/drive.readonly",
  "https://www.googleapis.com/auth/spreadsheets",
  "https://www.googleapis.com/auth/documents",
]

# ---------------------------------------------------------------------------
# OPTION B: Service account (alternative). Share the sheet with client_email.
# Remove the [google_oauth] block above if you use this instead.
# ---------------------------------------------------------------------------
# [gcp_service_account]
# type = "service_account"
# project_id = "your-project-id"
# private_key_id = "..."
# private_key = "-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"
# client_email = "your-sa@your-project-id.iam.gserviceaccount.com"
# client_id = "..."
# auth_uri = "https://accounts.google.com/o/oauth2/auth"
# token_uri = "https://oauth2.googleapis.com/token"
# auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
# client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/..."
